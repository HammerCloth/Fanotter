diff --git a/Caddyfile b/Caddyfile
index 5063a0d..c2d4654 100644
--- a/Caddyfile
+++ b/Caddyfile
@@ -36,3 +36,25 @@
     file_server
   }
 }
+
+# Fanotter（本周新番排表）：纯静态站，和 Beaver 共用这个 Caddy，走子域名。
+# 站点地址来自环境变量 FANOTTER_SITE（docker-compose 已传入，默认 fanotter.localhost，不影响 Beaver）。
+# 目录由 Fanotter 仓库的 GitHub Actions 部署：/srv/fanotter/releases/<sha>，current 软链指向线上版本。
+{$FANOTTER_SITE:fanotter.localhost} {
+  log {
+    output stdout
+    format console
+  }
+
+  encode gzip
+
+  root * /srv/fanotter/current
+
+  # Vite 打包的资源文件名带哈希，可以长期缓存；index.html 不缓存，切换版本后立刻生效
+  @assets path /assets/*
+  header @assets Cache-Control "public, max-age=31536000, immutable"
+  header /index.html Cache-Control "no-cache"
+
+  try_files {path} /index.html
+  file_server
+}
diff --git a/docker-compose.yml b/docker-compose.yml
index 7e2fb93..b881f45 100644
--- a/docker-compose.yml
+++ b/docker-compose.yml
@@ -35,9 +35,13 @@ services:
       - "443:443"
     environment:
       CADDY_SITE: ${CADDY_SITE:-:80}
+      # Fanotter 子域名；未设置时为 fanotter.localhost，不影响 Beaver
+      FANOTTER_SITE: ${FANOTTER_SITE:-fanotter.localhost}
     volumes:
       - ./Caddyfile:/etc/caddy/Caddyfile:ro
       - ./frontend-vue/dist:/srv/frontend:ro
+      # Fanotter 的静态文件，由其仓库的 GitHub Actions 部署到服务器的 /srv/fanotter
+      - /srv/fanotter:/srv/fanotter:ro
       - caddy_data:/data
       - caddy_config:/config
     restart: unless-stopped
